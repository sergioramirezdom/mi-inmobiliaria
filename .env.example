# Database configuration
# Get DATABASE_URL from Neon Tech: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/database

# Telegram Bot configuration
# Get TELEGRAM_TOKEN from @BotFather in Telegram
TELEGRAM_TOKEN=your_telegram_bot_token

# Your Telegram Chat ID (can get it by messaging the bot)
TELEGRAM_CHAT_ID=your_chat_id

# Optional: Debug mode
DEBUG=false

# Optional: Scraper settings
SCRAPER_TIMEOUT=30
SCRAPER_RETRIES=3
